# Supabase (cloud dev project: Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Gemini (Google AI Studio, free tier). Model ID: check AI Studio for the current free Flash model.
GEMINI_API_KEY=
GEMINI_MODEL=

# Web Push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Shared secret for /api/cron/tick (openssl rand -hex 32)
CRON_SECRET=

# Invite code required at sign-up
INVITE_CODE=
